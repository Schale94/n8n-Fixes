    {
      "parameters": {
        "jsCode": "const out = [];\n$input.all().forEach(function (it) {\n  const s = it.json;\n  if (!s.shipment_id || !s.invoice_file_id || !s.packing_file_id) return;\n  if (String(s.archived_at || '').trim() !== '') return;\n  out.push({ json: { shipment_id: s.shipment_id, order_id: s.order_id, file_id: s.invoice_file_id, kind: 'INV' } });\n  out.push({ json: { shipment_id: s.shipment_id, order_id: s.order_id, file_id: s.packing_file_id, kind: 'PL' } });\n});\nreturn out;"
      },
      "id": "eb8b6520-1071-4149-a413-05175061afd5",
      "name": "Split files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
