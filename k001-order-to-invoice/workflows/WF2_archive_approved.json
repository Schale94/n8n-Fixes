      "id": "6efccabb-e529-4c46-827e-f8b6870211e9",
      "name": "Move to K001_archive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        672,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Your Google account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const src = $('Split files').all().map(function (i) { return i.json; });\nconst res = $input.all().map(function (i) { return i.json; });\nconst by = {};\nsrc.forEach(function (s, idx) {\n  const r = res[idx] || {};\n  const ok = !r.error && r.id === s.file_id;\n  if (!by[s.shipment_id]) by[s.shipment_id] = { shipment_id: s.shipment_id, order_id: s.order_id, ok: true, error: '' };\n  if (!ok) {\n    by[s.shipment_id].ok = false;\n    const msg = r.error ? (typeof r.error === 'string' ? r.error : (r.error.message || JSON.stringify(r.error))) : 'move not confirmed';\n    by[s.shipment_id].error = (by[s.shipment_id].error ? by[s.shipment_id].error + '; ' : '') + s.kind + ': ' + String(msg).slice(0, 200);\n  }\n});\nconst now = $now.toISO();\nreturn Object.keys(by).map(function (k) {\n  const b = by[k];\n  return { json: { shipment_id: b.shipment_id, order_id: b.order_id, status: b.ok ? 'arhivirano' : 'greska_arhiva', archived_at: b.ok ? now : '', result: b.ok ? 'ok' : 'error', error: b.error } };\n});"
      },
