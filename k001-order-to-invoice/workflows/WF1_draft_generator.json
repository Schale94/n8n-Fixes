      "id": "403ee22e-ef6b-4c0e-a3c9-a601497d0615",
      "name": "Read shipments",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1120,
        0
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Your Google account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const orders = $('Read orders (status novo)').all().map(function (i) { return i.json; });\nconst items = $('Read order_items').all().map(function (i) { return i.json; });\nconst products = $('Read products').all().map(function (i) { return i.json; });\nconst customers = $('Read customers').all().map(function (i) { return i.json; });\n\nconst INCOTERMS = ['EXW', 'FOB', 'CIF', 'DAP'];\nconst CURRENCIES = ['AED', 'USD', 'EUR'];\nconst MAX_LINES = 8;\nconst REQUIRED = ['order_id', 'order_date', 'customer_id', 'incoterm', 'currency', 'payment_terms', 'ship_to'];\n\nconst pMap = {};\nproducts.forEach(function (p) { pMap[p.sku] = p; });\nconst cMap = {};\ncustomers.forEach(function (c) { cMap[c.customer_id] = c; });\n\nconst out = [];\norders.forEach(function (o) {\n  const errors = [];\n  REQUIRED.forEach(function (f) {\n    if (o[f] === undefined || o[f] === null || String(o[f]).trim() === '') errors.push('missing ' + f);\n  });\n  const cust = cMap[o.customer_id];\n  if (o.customer_id && !cust) errors.push('unknown customer_id');\n  if (o.incoterm && INCOTERMS.indexOf(o.incoterm) === -1) errors.push('invalid incoterm');\n  if (o.currency && CURRENCIES.indexOf(o.currency) === -1) errors.push('invalid currency');\n\n  const lines = items\n    .filter(function (l) { return l.order_id === o.order_id; })\n    .sort(function (a, b) { return Number(a.line_no) - Number(b.line_no); });\n  if (lines.length === 0) errors.push('no lines');\n  if (lines.length > MAX_LINES) errors.push('more than ' + MAX_LINES + ' lines');\n\n  const enriched = lines.map(function (l) {\n    const p = pMap[l.sku];\n    const qty = Number(l.qty);\n    const price = Number(l.unit_price);\n    if (!p) errors.push('line ' + l.line_no + ': unknown sku ' + l.sku);\n    if (!Number.isInteger(qty) || qty <= 0) errors.push('line ' + l.line_no + ': qty must be an integer > 0');\n    if (!(price > 0)) errors.push('line ' + l.line_no + ': unit_price must be > 0');\n    if (p && (p.hs_code === undefined || String(p.hs_code).trim() === '')) errors.push('line ' + l.line_no + ': hs_code empty');\n    return {\n      line_no: Number(l.line_no),\n      sku: l.sku,\n      qty: qty,\n      unit_price: price,\n      description: p ? p.description : '',\n      origin: p ? p.origin : '',\n      unit_weight_kg: p ? Number(p.unit_weight_kg) : 0,\n      dims_cm: p ? p.dims_cm : '',\n      hs_code: p ? String(p.hs_code) : ''\n    };\n  });\n\n  out.push({ json: { order_id: o.order_id, valid: errors.length === 0, errors: errors, order: o, customer: cust || null, lines: enriched } });\n});\nreturn out;"
      },
      "id": "f7411f39-bf67-4f5a-b469-d24c974eefd9",
      "name": "Code A: validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const shipments = $('Read shipments').all().map(function (i) { return i.json; }).filter(function (s) { return s.shipment_id; });\nconst year = $now.toFormat('yyyy');\nconst today = $now.toFormat('yyyy-MM-dd');\n\nfunction maxNum(field, prefix) {\n  let m = 0;\n  shipments.forEach(function (s) {\n    const v = String(s[field] || '');\n    if (v.indexOf(prefix) === 0) {\n      const n = parseInt(v.slice(prefix.length), 10);\n      if (n > m) m = n;\n    }\n  });\n  return m;\n}\nfunction pad(n) { return String(n).padStart(4, '0'); }\nfunction r2(n) { return Math.round(n * 100) / 100; }\n\nlet inv = maxNum('invoice_no', 'INV-' + year + '-');\nlet pl = maxNum('packing_no', 'PL-' + year + '-');\nlet sh = maxNum('shipment_id', 'SH-');\nconst PKG_KG = 25;\n\nconst out = [];\n$input.all().forEach(function (it) {\n  const d = it.json;\n  if (!d.valid) {\n    out.push({ json: d });\n    return;\n  }\n  inv += 1; pl += 1; sh += 1;\n  const lines = d.lines.map(function (l) {\n    return Object.assign({}, l, { line_total: r2(l.qty * l.unit_price), line_kg: r2(l.qty * l.unit_weight_kg) });\n  });\n  const subtotal = r2(lines.reduce(function (a, l) { return a + l.line_total; }, 0));\n  const totalKg = r2(lines.reduce(function (a, l) { return a + l.line_kg; }, 0));\n  out.push({ json: Object.assign({}, d, {\n    lines: lines,\n    subtotal: subtotal,\n    total: subtotal,\n    total_net_kg: totalKg,\n    packages_est: Math.ceil(totalKg / PKG_KG),\n    invoice_no: 'INV-' + year + '-' + pad(inv),\n    packing_no: 'PL-' + year + '-' + pad(pl),\n    shipment_id: 'SH-' + pad(sh),\n    invoice_date: today\n  }) });\n});\nreturn out;"
      },
