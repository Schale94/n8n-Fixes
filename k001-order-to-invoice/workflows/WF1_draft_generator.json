    {
      "parameters": {
        "jsCode": "const cur = $input.first().json;\nconst d = $('Code B: totals and numbering').all().map(function (i) { return i.json; }).filter(function (x) { return x.valid && x.order_id === cur.order_id; })[0];\nconst TPL_INVOICE = '<TEMPLATE_INVOICE_DOC_ID>';\nconst TPL_PACKING = '<TEMPLATE_PACKING_DOC_ID>';\nfunction f2(n) { return Number(n).toFixed(2); }\nconst pairs = {\n  invoice_no: d.invoice_no,\n  invoice_date: d.invoice_date,\n  packing_no: d.packing_no,\n  order_id: d.order.order_id,\n  order_date: d.order.order_date,\n  customer_name: d.customer.name,\n  customer_address: d.customer.address + ', ' + d.customer.country,\n  ship_to: d.order.ship_to,\n  incoterm: d.order.incoterm,\n  currency: d.order.currency,\n  payment_terms: d.order.payment_terms,\n  subtotal: f2(d.subtotal),\n  total: f2(d.total),\n  total_net_kg: f2(d.total_net_kg),\n  packages_est: d.packages_est\n};\nfor (let n = 1; n <= 8; n++) {\n  const l = d.lines[n - 1];\n  pairs['i' + n + '_n'] = l ? l.line_no : '';\n  pairs['i' + n + '_sku'] = l ? l.sku : '';\n  pairs['i' + n + '_desc'] = l ? l.description : '';\n  pairs['i' + n + '_qty'] = l ? l.qty : '';\n  pairs['i' + n + '_price'] = l ? f2(l.unit_price) : '';\n  pairs['i' + n + '_total'] = l ? f2(l.line_total) : '';\n  pairs['i' + n + '_ukg'] = l ? f2(l.unit_weight_kg) : '';\n  pairs['i' + n + '_lkg'] = l ? f2(l.line_kg) : '';\n  pairs['i' + n + '_dims'] = l ? l.dims_cm : '';\n  pairs['i' + n + '_origin'] = l ? l.origin : '';\n}\nconst requests = Object.keys(pairs).map(function (k) {\n  const v = pairs[k];\n  return { replaceAllText: { containsText: { text: '{{' + k + '}}', matchCase: true }, replaceText: (v === undefined || v === null) ? '' : String(v) } };\n});\nconst meta = { order_id: d.order_id, shipment_id: d.shipment_id, invoice_no: d.invoice_no, packing_no: d.packing_no };\nreturn [\n  { json: Object.assign({ kind: 'INV', templateId: TPL_INVOICE, docName: d.invoice_no + ' (doc)', pdfName: d.invoice_no + '.pdf', requests: requests }, meta) },\n  { json: Object.assign({ kind: 'PL', templateId: TPL_PACKING, docName: d.packing_no + ' (doc)', pdfName: d.packing_no + '.pdf', requests: requests }, meta) }\n];"
      },
